{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "class",
    "type",
    "timebox",
    "topic_ids",
    "file",
    "motivating_excerpts",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "const": "prep_drill"
    },
    "type": {
      "enum": [
        "recall",
        "define-a-term",
        "decide-in-a-scenario",
        "name-what-is-still-unknown"
      ]
    },
    "timebox": {
      "enum": [
        3,
        10,
        25
      ]
    },
    "topic_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "motivating_excerpts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "record.schema.json"
      }
    },
    "answer": {
      "$ref": "record.schema.json"
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}
